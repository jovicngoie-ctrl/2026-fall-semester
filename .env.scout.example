# SCOUT Configuration
# Copy this file to .env.local and fill in your values

# OpenAI API (same as Nova)
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_ORG_ID=optional-org-id

# Supabase Configuration (same as Nova)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Frontend environment variables (add to .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=your-anon-key-here

# SCOUT Configuration
SCOUT_MIN_DEFAULT_SCORE=70
SCOUT_MAX_PROSPECTS_PER_RUN=50
SCOUT_WEBSITE_TIMEOUT_MS=5000

# Optional: Sentry/Analytics
SENTRY_DSN=optional-sentry-dsn
